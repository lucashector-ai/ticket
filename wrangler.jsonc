{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ticket",
  "main": "custom-worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  // mantém as variáveis criadas no painel da Cloudflare (ex.: chaves do Turnstile) a cada deploy
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://ticketswin.com.br",
    "BANK_URL": "https://banco.ticketswin.com.br",
    // quem entra na central secreta (/tw-central); separados por vírgula
    "ADMIN_EMAILS": "lucas@ticketswin.com.br,lucashectorart@gmail.com",
    "PRODUCER_APPROVAL_EMAIL": "lucas@ticketswin.com.br",
    "NEXT_INC_CACHE_R2_PREFIX": "incremental-cache"
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "onde-media" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "onde-cache" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "e0598640fff84473847be030aa1c2096" }
  ],
  "images": { "binding": "IMAGES" },
  // a cada minuto: avisos de abertura/pré-venda e limpeza da fila virtual (ver custom-worker.js)
  "triggers": { "crons": ["* * * * *"] },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "ticket" }
  ]
}
