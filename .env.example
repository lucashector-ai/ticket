# Copie para .env.local e preencha. Nunca comite .env.local.
DATABASE_URL=postgresql://user:pass@host/onde?sslmode=require
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=gere-com-openssl-rand-base64-32
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Busca de locais reais na etapa "Onde vai ser?" (Google Places API New). Sem ela, a busca usa só os locais cadastrados.
GOOGLE_PLACES_API_KEY=
# Pagamentos pela Stripe (cartão com parcelamento e Pix dentro do checkout). Só no servidor, lidas em runtime:
# nada de NEXT_PUBLIC_ (a chave publicável vai para o navegador como prop). Sem STRIPE_SECRET_KEY o checkout
# fica no modo de teste (nada é cobrado; pedido pago com payment_ref TEST-… e fora do saldo do produtor).
# Use as chaves de teste (sk_test_/pk_test_) em desenvolvimento; cartão de teste 4242 4242 4242 4242.
# STRIPE_SECRET_KEY=sk_test_...   (vazia = modo de teste)
STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PUBLISHABLE_KEY=
# Signing secret do endpoint /api/webhooks/stripe (Dashboard → Webhooks, ou `stripe listen` no dev)
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET=
